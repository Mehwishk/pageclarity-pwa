# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables.

# Server only (never prefix with VITE_): used by api/* and scripts/library.ts.
ANTHROPIC_API_KEY=
# Saved analyses (Supabase -> Project Settings -> API). The service role key
# bypasses row level security: keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, public: Google Books API key restricted to your site's domain.
VITE_GOOGLE_BOOKS_KEY=

# Optional: lets a static preview build call a deployed API.
VITE_API_BASE=
